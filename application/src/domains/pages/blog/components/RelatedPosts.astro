---
import { APP_BLOG } from 'astrowind:config';
import { getRelatedPosts } from '~/domains/pages/blog/services/posts';
import { getLangFromUrl } from '~/i18n/utils';
import BlogHighlightedPosts from '~/shared/components/widgets/BlogHighlightedPosts.astro';
import { getBlogPermalink } from '~/shared/url/permalinks';
import type { Post } from '~/types';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);

const relatedPosts = post.tags ? await getRelatedPosts(post, 4) : [];
---

{APP_BLOG.isRelatedPostsEnabled ? (
    <BlogHighlightedPosts
      classes={{
        container:
          'pt-0 lg:pt-0 md:pt-0 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
      }}
      title="Related Posts"
      linkText="View All Posts"
      linkUrl={getBlogPermalink(currentLang)}
      postIds={relatedPosts.map((post) => post.id)}
    />
  ) : null}
