---
import { Icon } from 'astro-icon/components';

import type { PracticalInfoParkingGuide } from '~/domains/pages/practical-info/model/parking';

export interface Props {
  parkingGuide: PracticalInfoParkingGuide;
}

const { parkingGuide } = Astro.props as Props;
---

<section class="not-prose px-4 pb-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <header class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        {parkingGuide.heroTitle}
      </h2>
      <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">{parkingGuide.heroIntro}</p>
    </header>

    <div class="mt-16 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div>
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-amber-600 dark:text-amber-300">
            {parkingGuide.categoriesTitle}
          </p>
          <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">{parkingGuide.categoriesIntro}</p>
        </div>

        <div class="mt-8 space-y-10">
          {parkingGuide.categories.map((category) => (
            <section>
              <div class="flex items-start gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-300">
                  <Icon name={category.icon} class="h-5 w-5" />
                </span>
                <div>
                  <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-amber-600 dark:text-amber-300">
                    {category.badge}
                  </p>
                  <h3 class="mt-1 text-xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
                    {category.title}
                  </h3>
                  <p class="mt-1 text-sm leading-7 text-slate-600 dark:text-slate-300">{category.description}</p>
                </div>
              </div>

              <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                {category.options.map((option) => (
                  <article class="flex flex-col rounded-3xl border border-black/5 bg-white p-6 shadow-[0_1px_3px_rgba(15,23,42,0.05)] dark:border-white/10 dark:bg-slate-900">
                    <h4 class="text-lg font-bold tracking-tight text-slate-900 dark:text-slate-50">{option.name}</h4>
                    <p class="mt-2 flex-1 text-sm leading-7 text-slate-600 dark:text-slate-300">{option.blurb}</p>

                    {option.featureTags.length > 0 && (
                      <div class="mt-4 flex flex-wrap gap-1.5">
                        {option.featureTags.map((tag) => (
                          <span class="rounded-full border border-black/10 px-2.5 py-0.5 text-xs text-slate-500 dark:border-white/15 dark:text-slate-400">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}

                    <p class="mt-4 flex items-start gap-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
                      <Icon name="tabler:map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-amber-500 dark:text-amber-300" />
                      <span>{option.address}</span>
                    </p>

                    <div class="mt-5">
                      <a
                        class="inline-flex items-center gap-1.5 rounded-full border border-black/10 px-3.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-amber-300 hover:text-amber-700 dark:border-white/15 dark:text-slate-200 dark:hover:border-amber-400 dark:hover:text-amber-300"
                        href={option.mapHref}
                        target="_blank"
                        rel="noreferrer"
                      >
                        <span>{option.mapLabel}</span>
                        <Icon name="tabler:map-2" class="h-4 w-4" />
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>

      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        <section>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-amber-600 dark:text-amber-300">
            {parkingGuide.tipsTitle}
          </p>
          <ul class="mt-4 space-y-3">
            {parkingGuide.tips.map((tip) => (
              <li class="flex gap-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
                <Icon name="tabler:circle-check" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-300" />
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="border-t border-black/5 pt-8 dark:border-white/10">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-amber-600 dark:text-amber-300">
            {parkingGuide.resourcesTitle}
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {parkingGuide.resources.map((resource) => (
              <a
                class="inline-flex items-center gap-1.5 rounded-full border border-black/10 px-3.5 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:border-amber-300 hover:text-amber-700 dark:border-white/15 dark:text-slate-200 dark:hover:border-amber-400 dark:hover:text-amber-300"
                href={resource.href}
                target="_blank"
                rel="noreferrer"
              >
                <span>{resource.text}</span>
                <Icon name="tabler:arrow-up-right" class="h-3.5 w-3.5" />
              </a>
            ))}
          </div>
        </section>

        <section class="border-t border-black/5 pt-8 dark:border-white/10">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-amber-600 dark:text-amber-300">
            {parkingGuide.notesTitle}
          </p>
          <ul class="mt-4 space-y-3">
            {parkingGuide.notes.map((note) => (
              <li class="flex gap-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
                <Icon name="tabler:info-circle" class="mt-0.5 h-4 w-4 shrink-0 text-amber-500 dark:text-amber-300" />
                <span>{note}</span>
              </li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</section>
