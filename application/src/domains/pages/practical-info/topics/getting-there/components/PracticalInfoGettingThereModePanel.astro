---
import { Icon } from 'astro-icon/components';
import type { PracticalInfoResourceLink } from '~/domains/pages/practical-info/model/links';
import type { PracticalInfoTravelMode } from '~/domains/pages/practical-info/model/travel';

export interface Props {
  plannerId: string;
  mode: PracticalInfoTravelMode;
  index: number;
  routeLabel: string;
  routeTitle: string;
  checklistTitle: string;
  linksTitle: string;
  links: readonly PracticalInfoResourceLink[];
}

const { plannerId, mode, index, routeLabel, routeTitle, checklistTitle, linksTitle, links } = Astro.props as Props;
---

<article
  id={`${plannerId}-panel-${index}`}
  role="tabpanel"
  aria-labelledby={`${plannerId}-tab-${index}`}
  class:list={[
    index === 0 ? '' : 'hidden',
    'travel-planner-panel rounded-3xl border border-black/5 bg-white shadow-[0_1px_3px_rgba(15,23,42,0.05)] dark:border-white/10 dark:bg-slate-900',
  ]}
  data-planner-panel
  data-index={index}
>
  <div
    class="flex flex-col gap-5 border-b border-black/5 p-6 sm:flex-row sm:items-start sm:justify-between sm:p-8 dark:border-white/10"
  >
    <div class="flex items-start gap-4">
      <span
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-sky-50 text-sky-600 dark:bg-sky-500/15 dark:text-sky-300"
      >
        <Icon name={mode.icon} class="h-6 w-6" />
      </span>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-600 dark:text-sky-300">{mode.badge}</p>
        <h4 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-50">{mode.title}</h4>
        <p class="mt-2 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">{mode.summary}</p>
      </div>
    </div>
    <span
      class="inline-flex shrink-0 items-center gap-1.5 self-start rounded-full bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white dark:bg-slate-700"
    >
      <Icon name="tabler:clock" class="h-3.5 w-3.5" />
      {mode.duration}
    </span>
  </div>

  <div class="p-6 sm:p-8">
    <div class="flex items-center gap-2">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">{routeLabel}</p>
      <span class="h-px flex-1 bg-black/5 dark:bg-white/10"></span>
      <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">{routeTitle}</p>
    </div>

    <ol class="relative mt-6 grid gap-8 sm:grid-cols-3">
      <div
        class="pointer-events-none absolute left-5 right-5 top-4 hidden h-px bg-gradient-to-r from-sky-200 via-sky-200 to-transparent sm:block dark:from-sky-800 dark:via-sky-800"
      ></div>
      {mode.route.map((stop, routeIndex) => (
        <li class="relative flex flex-col">
          <div class="flex items-center gap-3">
            <span class="relative z-10 flex h-9 w-9 items-center justify-center rounded-full bg-sky-600 text-sm font-bold text-white ring-4 ring-white dark:bg-sky-400 dark:text-slate-950 dark:ring-slate-900">
              {routeIndex + 1}
            </span>
            <Icon name={stop.icon} class="h-5 w-5 text-slate-400 dark:text-slate-500" />
          </div>
          <h5 class="mt-4 text-base font-semibold text-slate-900 dark:text-slate-50">{stop.title}</h5>
          <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300">{stop.detail}</p>
        </li>
      ))}
    </ol>

    <div class="mt-8 grid gap-8 border-t border-black/5 pt-8 lg:grid-cols-2 dark:border-white/10">
      <section>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">{checklistTitle}</p>
        <ul class="mt-4 space-y-3">
          {mode.details.map((detail) => (
            <li class="flex gap-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
              <Icon name="tabler:circle-check" class="mt-0.5 h-4 w-4 shrink-0 text-sky-500 dark:text-sky-300" />
              <span>{detail}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">{linksTitle}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {links.map((link) => (
            <a
              class="inline-flex items-center gap-1.5 rounded-full border border-black/10 px-3.5 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:border-sky-300 hover:text-sky-700 dark:border-white/15 dark:text-slate-200 dark:hover:border-sky-400 dark:hover:text-sky-300"
              href={link.href}
              target="_blank"
              rel="noreferrer"
            >
              <span>{link.text}</span>
              <Icon name="tabler:arrow-up-right" class="h-3.5 w-3.5" />
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</article>
