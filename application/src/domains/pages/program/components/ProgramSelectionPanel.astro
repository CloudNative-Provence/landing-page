---
import { Icon } from 'astro-icon/components';

import type { ProgramScheduleSelection } from './program-schedule.types';

interface Props {
  selection: ProgramScheduleSelection;
  filters: {
    displayLabel: string;
    liveLabel: string;
    fullscreenLabel: string;
  };
}

const { selection, filters } = Astro.props;

const utilityButtonClass =
  'inline-flex h-10 w-10 items-center justify-center rounded-xl border border-gray-200 bg-gray-50 text-gray-700 transition hover:border-gray-300 hover:bg-gray-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/30 dark:border-white/15 dark:bg-white/5 dark:text-white dark:hover:border-white/25 dark:hover:bg-white/10 dark:focus-visible:ring-white/20';

const liveToggleClass =
  'group inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-xl border border-gray-200 bg-gray-50 text-gray-700 transition hover:border-gray-300 hover:bg-gray-100 has-[:checked]:border-sky-500 has-[:checked]:bg-sky-500 has-[:checked]:text-white has-[:checked]:shadow-md has-[:checked]:shadow-sky-500/25 focus-visible:outline-none has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-sky-400/30 dark:border-white/15 dark:bg-white/5 dark:text-white dark:hover:border-white/25 dark:hover:bg-white/10 dark:has-[:checked]:border-sky-400 dark:has-[:checked]:bg-sky-500 dark:has-[:checked]:text-white dark:has-[:checked]:shadow-sky-500/30 dark:has-[:focus-visible]:ring-white/20';

const primaryIconButtonClass =
  'inline-flex h-10 w-10 items-center justify-center rounded-xl bg-sky-500 text-white shadow-md shadow-sky-500/25 transition hover:bg-sky-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500/40';
---

<section
  class="relative overflow-hidden text-gray-900 sm:rounded-2xl sm:border sm:border-gray-200 sm:bg-white sm:px-4 sm:py-3 sm:shadow-lg sm:shadow-slate-900/5 dark:text-white sm:dark:border-slate-800 sm:dark:bg-slate-950 sm:dark:shadow-slate-900/10"
>
  <div
    class="pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full bg-sky-500/10 blur-3xl dark:bg-sky-500/20"
    aria-hidden="true"
  ></div>

  <div class="relative grid gap-3 xl:grid-cols-[minmax(0,1.7fr)_minmax(20rem,0.95fr)]">
    <div
      class="rounded-2xl border border-gray-200 bg-white/80 p-3 shadow-sm dark:border-slate-800 dark:bg-slate-900/60"
    >
      <div class="flex items-center justify-between gap-3">
        <div class="flex min-w-0 flex-1 items-center gap-3">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-600 ring-1 ring-inset ring-sky-200 dark:bg-sky-500/15 dark:text-sky-300 dark:ring-sky-400/30"
          >
            <Icon name="tabler:calendar-heart" class="h-5 w-5" />
          </span>

          <div class="group min-w-0 flex-1">
            <p class="flex items-baseline gap-1.5 text-base font-bold leading-tight">
              <span data-selected-count class="tabular-nums text-sky-600 dark:text-sky-300">0</span>
              <span class="font-semibold text-gray-900 dark:text-white">{selection.savedLabel}</span>
            </p>
            <p class="text-xs text-gray-500 group-has-[[data-program-status]:not(:empty)]:hidden dark:text-slate-400">
              {selection.subtitle}
            </p>
            <p
              class="hidden text-xs text-sky-600 [&:not(:empty)]:block dark:text-sky-200"
              aria-live="polite"
              data-program-status
            ></p>
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <button
            type="button"
            data-clear-selection
            title={selection.clearLabel}
            class={`${utilityButtonClass} disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-gray-200 disabled:hover:bg-gray-50 dark:disabled:hover:border-white/15 dark:disabled:hover:bg-white/5`}
          >
            <span class="sr-only">{selection.clearLabel}</span>
            <Icon name="tabler:trash" class="h-4 w-4" />
          </button>
          <button type="button" data-share-selection title={selection.shareLabel} class={primaryIconButtonClass}>
            <span class="sr-only">{selection.shareLabel}</span>
            <Icon name="tabler:share-2" class="h-4 w-4" />
          </button>
          <button type="button" data-export-selection title={selection.exportLabel} class={utilityButtonClass}>
            <span class="sr-only">{selection.exportLabel}</span>
            <Icon name="tabler:calendar-event" class="h-4 w-4" />
          </button>
        </div>
      </div>
    </div>

    <div
      class="rounded-2xl border border-gray-200 bg-gray-50/80 p-3 shadow-sm dark:border-slate-800 dark:bg-slate-900/40"
    >
      <div class="flex items-center justify-between gap-3">
        <div class="flex min-w-0 items-center gap-2 text-xs font-medium text-gray-500 dark:text-slate-400">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-sky-600 ring-1 ring-inset ring-gray-200 dark:bg-slate-950/70 dark:text-sky-300 dark:ring-slate-700"
          >
            <Icon name="tabler:device-tv" class="h-4.5 w-4.5" />
          </span>
          <span class="truncate">{filters.displayLabel}</span>
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <label class={liveToggleClass} title={filters.liveLabel}>
            <input data-filter-live type="checkbox" class="sr-only">
            <span class="sr-only">{filters.liveLabel}</span>
            <span
              class="relative flex h-2.5 w-2.5 items-center justify-center text-sky-500 group-has-[:checked]:text-white dark:text-sky-300 dark:group-has-[:checked]:text-white"
            >
              <span
                class="absolute inline-flex h-full w-full rounded-full bg-current opacity-60 group-has-[:checked]:animate-ping"
              ></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-current"></span>
            </span>
          </label>

          <button
            type="button"
            data-fullscreen-toggle
            hidden
            title={filters.fullscreenLabel}
            class={utilityButtonClass}
          >
            <span class="sr-only">{filters.fullscreenLabel}</span>
            <Icon name="tabler:maximize" class="h-4 w-4 text-sky-600 dark:text-sky-300" />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
