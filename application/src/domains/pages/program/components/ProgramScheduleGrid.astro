---
import { type ProgramRoom, type ProgramSession } from '~/domains/pages/program/model/schedule';
import { ProgramRoomColumns } from '~/domains/pages/program/services/room-columns';
import { mergeSharedProgramSessions } from '~/domains/pages/program/services/shared-sessions';
import { buildProgramTimelineLayout } from '~/domains/pages/program/services/timeline-layout';
import ProgramScheduleSlot from './ProgramScheduleSlot.astro';
import type { ProgramScheduleLabels } from './program-schedule.types';

interface Props {
  labels: ProgramScheduleLabels;
  rooms: readonly ProgramRoom[];
  sessions: readonly ProgramSession[];
  timezone: string;
}

const { labels, rooms, sessions, timezone } = Astro.props;
const roomLabels = new Map(rooms.map((room) => [room.id, room.label]));
const displaySessions = mergeSharedProgramSessions(sessions);
const { columns: scheduledRooms, slots } = ProgramRoomColumns.build(rooms, displaySessions);
const timeline = buildProgramTimelineLayout(slots.map(({ slot }) => slot));
---

<div
  data-program-room-grid
  style={{
    '--program-room-count': Math.max(scheduledRooms.length, 1),
    '--program-time-rows': timeline.rowCount,
  }}
  class="grid gap-x-5 gap-y-3 md:grid-cols-[repeat(var(--program-room-count),minmax(0,1fr))] md:grid-rows-[auto_repeat(var(--program-time-rows),auto)]"
>
  {scheduledRooms.map((room, index) => (
    <h2
      data-program-room-header
      data-room-id={room.id}
      data-room-ids={room.roomIds.join(',')}
      style={{ '--program-room-column': index + 1 }}
      class="sticky top-24 z-10 hidden items-center gap-3 rounded-2xl border border-gray-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-gray-900 shadow-sm md:col-start-[var(--program-room-column)] md:row-start-1 md:flex dark:border-slate-800 dark:bg-slate-950 dark:text-white"
    >
      <span class={`h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b ${room.accent}`} aria-hidden="true"></span>
      {room.label}
    </h2>
  ))}

  {slots.map(({ columnIds, slot }) => (
    <ProgramScheduleSlot
      room={columnIds.length === 1 ? scheduledRooms.find((room) => room.id === columnIds[0]) : undefined}
      column={scheduledRooms.findIndex((room) => room.id === columnIds[0]) + 1}
      columnIds={columnIds}
      timeSlot={slot}
      timeline={timeline}
      labels={labels}
      timezone={timezone}
      roomLabels={roomLabels}
    />
  ))}
</div>
