---
import type { ProgramSession } from '~/domains/pages/program/model/schedule';

interface Props {
  session: ProgramSession;
  roomLabel: string;
  trackLabel: string;
  tone: string;
  isGlobal: boolean;
  labels: {
    roomLabel: string;
    speakersLabel: string;
    addLabel: string;
    removeLabel: string;
    detailsLabel: string;
  };
  searchText: string;
}

const { session, roomLabel, trackLabel, tone, isGlobal, labels, searchText } = Astro.props;
const detailsPopoverId = `program-session-details-${session.id}`;
---

<article
  data-program-session
  data-session-id={session.id}
  data-session-title={session.title}
  data-session-description={session.description}
  data-session-location={roomLabel}
  data-search-text={searchText}
  data-track-ids={session.trackIds.join(',')}
  data-room-ids={session.roomIds.join(',')}
  data-starts-at={session.startsAt}
  data-ends-at={session.endsAt}
  data-global={String(isGlobal)}
  class:list={[
    'rounded-[1.5rem] border border-gray-200 bg-white p-3 shadow-sm transition dark:border-slate-800 dark:bg-slate-950/70 xl:min-h-[12rem]',
    isGlobal &&
      'bg-gradient-to-br from-sky-50 via-white to-cyan-50 dark:from-sky-950/20 dark:via-slate-950/70 dark:to-cyan-950/20',
  ]}
>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-gray-50 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-gray-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300"
      >
        <span class={`h-2 w-2 rounded-full bg-gradient-to-r ${tone}`}></span>
        {trackLabel}
      </div>
      <h3 class="mt-2 text-base font-semibold leading-tight text-gray-900 dark:text-white xl:text-lg">
        {session.title}
      </h3>
    </div>
    <button
      type="button"
      data-program-toggle={session.id}
      data-add-label={labels.addLabel}
      data-remove-label={labels.removeLabel}
      aria-pressed="false"
      class="inline-flex w-full shrink-0 items-center justify-center rounded-full bg-sky-500 px-3.5 py-2 text-sm font-semibold text-white transition hover:bg-sky-400 sm:w-auto sm:px-3 sm:py-1.5 sm:text-xs"
    >
      {labels.addLabel}
    </button>
  </div>

  <div class="mt-3 flex flex-wrap gap-2 text-xs text-muted xl:text-sm">
    <span
      class="inline-flex items-center gap-2 rounded-full bg-sky-50 px-2.5 py-1 text-sky-700 dark:bg-sky-950/40 dark:text-sky-200"
    >
      <span class="font-medium">{labels.roomLabel}:</span>
      {roomLabel}
    </span>
    {session.format && (
        <span class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-2.5 py-1 text-gray-700 dark:bg-slate-900 dark:text-slate-300">
          {session.format}
        </span>
      )}
  </div>

  {session.speakers?.length ? (
      <p class="mt-3 text-xs font-medium text-gray-700 dark:text-slate-200 xl:text-sm">
        {labels.speakersLabel}: {session.speakers.join(', ')}
      </p>
    ) : null}

  {session.description || session.tags?.length ? (
      <>
        <div class="mt-3">
          <button
            type="button"
            popovertarget={detailsPopoverId}
            popovertargetaction="toggle"
            aria-haspopup="dialog"
            class="inline-flex items-center rounded-full border border-gray-200 bg-gray-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-sky-600 transition hover:border-sky-200 hover:bg-sky-50 dark:border-slate-700 dark:bg-slate-900 dark:text-sky-300 dark:hover:border-sky-800 dark:hover:bg-slate-800"
          >
            {labels.detailsLabel}
          </button>
        </div>

        <div
          id={detailsPopoverId}
          popover="auto"
          class="fixed inset-0 m-auto max-h-[calc(100vh-2rem)] w-[min(36rem,calc(100vw-2rem))] overflow-auto rounded-[1.5rem] border border-gray-200 bg-white p-5 text-left text-gray-900 shadow-2xl backdrop:bg-slate-950/50 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        >
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sky-600 dark:text-sky-300">{trackLabel}</p>
            <h4 class="mt-2 text-lg font-semibold">{session.title}</h4>
          </div>

          <div class="mt-4 flex flex-wrap gap-2 text-xs text-muted">
            <span class="inline-flex items-center gap-2 rounded-full bg-sky-50 px-2.5 py-1 text-sky-700 dark:bg-sky-950/40 dark:text-sky-200">
              <span class="font-medium">{labels.roomLabel}:</span>
              {roomLabel}
            </span>
            {session.format && (
              <span class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-2.5 py-1 text-gray-700 dark:bg-slate-900 dark:text-slate-300">
                {session.format}
              </span>
            )}
          </div>

          {session.speakers?.length ? (
            <p class="mt-4 text-sm font-medium text-gray-700 dark:text-slate-200">
              {labels.speakersLabel}: {session.speakers.join(', ')}
            </p>
          ) : null}

          {session.description ? <p class="mt-4 text-sm leading-6 text-muted">{session.description}</p> : null}

          {session.tags?.length ? (
            <div class="mt-4 flex flex-wrap gap-2">
              {session.tags.map((tag) => (
                <span class="rounded-full border border-gray-200 px-2.5 py-1 text-[0.7rem] text-gray-600 dark:border-slate-700 dark:text-slate-300">
                  {tag}
                </span>
              ))}
            </div>
          ) : null}
        </div>
      </>
    ) : null}
</article>
