---
import type { ProgramHighlight, ProgramScheduleHero } from './program-schedule.types';

interface Props {
  hero: ProgramScheduleHero;
  highlights: readonly ProgramHighlight[];
}

const { hero, highlights } = Astro.props;
---

<section
  class="relative overflow-hidden border-b border-gray-200 bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.12),_transparent_34%),radial-gradient(circle_at_top_right,_rgba(168,85,247,0.1),_transparent_30%),linear-gradient(180deg,_#ffffff,_#f8fafc)] dark:border-slate-800 dark:bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.18),_transparent_32%),radial-gradient(circle_at_top_right,_rgba(168,85,247,0.18),_transparent_28%),linear-gradient(180deg,_rgba(15,23,42,0.98),_rgba(15,23,42,0.92))]"
>
  <div class="mx-auto flex w-full max-w-[1600px] flex-col gap-6 px-4 py-10 sm:gap-8 sm:px-6 sm:py-12 xl:px-8 2xl:px-10">
    <div class="flex flex-col gap-8 xl:flex-row xl:items-end xl:justify-between">
      <div class="max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-600 dark:text-sky-300">{hero.tagline}</p>
        <h1
          class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:mt-4 sm:text-4xl md:text-5xl dark:text-white"
        >
          {hero.title}
        </h1>
        <p class="mt-4 text-base text-gray-600 sm:mt-5 sm:text-lg dark:text-slate-200">{hero.subtitle}</p>
        <div class="mt-6 flex flex-wrap gap-2 text-sm text-gray-700 sm:gap-3 dark:text-slate-200">
          <span
            class="rounded-full border border-gray-200 bg-white px-4 py-2 shadow-sm dark:border-white/15 dark:bg-white/10 dark:shadow-none"
            >{hero.date}</span
          >
          <span
            class="rounded-full border border-gray-200 bg-white px-4 py-2 shadow-sm dark:border-white/15 dark:bg-white/10 dark:shadow-none"
            >{hero.venue}</span
          >
          <span
            class="rounded-full border border-gray-200 bg-white px-4 py-2 shadow-sm dark:border-white/15 dark:bg-white/10 dark:shadow-none"
            >{hero.timezone}</span
          >
        </div>
      </div>
      <div class="grid grid-cols-3 gap-2 sm:gap-4 xl:min-w-[32rem]">
        {highlights.map((highlight) => (
            <div class="rounded-2xl border border-gray-200 bg-white p-3 text-center shadow-sm sm:rounded-3xl sm:p-5 sm:text-left dark:border-white/10 dark:bg-white/10 dark:shadow-none dark:backdrop-blur">
              <div class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">{highlight.value}</div>
              <div class="mt-1 text-xs text-gray-500 sm:text-sm dark:text-slate-300">{highlight.label}</div>
            </div>
          ))}
      </div>
    </div>
  </div>
</section>
