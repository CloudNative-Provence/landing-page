---
import ProgramSpeaker from '~/domains/pages/program/components/ProgramSpeaker.astro';
import type { ProgramSpeaker as Speaker } from '~/domains/pages/program/model/schedule';
import type { SpeakersPageData } from '~/domains/pages/speakers/services/page-data';
import Hero from '~/shared/components/widgets/Hero.astro';

export interface Props {
  hero: SpeakersPageData['hero'];
  section: SpeakersPageData['section'];
  labels: SpeakersPageData['labels'];
  speakers: readonly Speaker[];
}

const { hero, section, labels, speakers } = Astro.props;
---

<Hero tagline={hero.tagline}>
  <Fragment slot="title" set:html={hero.title} />
  <Fragment slot="subtitle" set:text={hero.subtitle} />
</Hero>

<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="text-3xl font-bold tracking-tight md:text-4xl">{section.title}</h2>
    <p class="mt-4 text-lg text-muted">{section.subtitle}</p>
  </div>

  {speakers.length ? (
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {speakers.map((speaker) => (
        <article class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <ProgramSpeaker speaker={speaker} id={`speaker-${speaker.id}`} labels={labels} />
        </article>
      ))}
    </div>
  ) : (
    <p class="mt-12 text-center text-lg text-muted">{section.emptyState}</p>
  )}
</section>
