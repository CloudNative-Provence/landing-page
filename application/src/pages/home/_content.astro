---
import { type CfpAvailabilityPhase, resolveCfpPhase } from '~/domains/event/cfp/availability';
import Image from '~/shared/components/common/Image.astro';
import Button from '~/shared/components/ui/Button.astro';
import CallToAction from '~/shared/components/widgets/CallToAction.astro';
import CountDown from '~/shared/components/widgets/CountDown.astro';
import Features from '~/shared/components/widgets/Features.astro';
import Hero from '~/shared/components/widgets/Hero.astro';
import Note from '~/shared/components/widgets/Note.astro';
import Stats from '~/shared/components/widgets/Stats.astro';
import { getPermalink } from '~/shared/url/permalinks';
import type { Image as ImageType, Item, Stat } from '~/types';

type ActionItem = {
  href: string;
  text?: string;
  icon?: string;
  variant?: 'primary' | 'secondary' | 'tertiary' | 'link';
} & Record<string, unknown>;

type CfpAvailabilityLabels = {
  upcoming: string;
  open: string;
  closed: string;
};

export interface Props {
  hero: {
    actions: readonly ActionItem[];
    image?: unknown;
    badge?: string;
    title?: string | { main?: string; subtitle?: string; date?: string; location?: string };
    subtitle?: string;
    eventDate?: string;
  };
  note: {
    title?: string;
    description?: string;
  };
  about?: {
    id?: string;
    title?: string;
    intro?: string;
    paragraph2?: string;
    stats?: readonly Stat[];
    whatToExpect?: {
      title?: string;
      items?: readonly Item[];
    };
    values?: {
      title?: string;
      items?: readonly Item[];
    };
  };
  cfp?: {
    id?: string;
    title?: string;
    intro?: string;
    status?: string;
    availability?: {
      opensAt: string;
      closesAt?: string;
      statuses: CfpAvailabilityLabels;
    };
    image?: unknown;
    importantDates?: {
      title?: string;
      items?: readonly { label: string; date: string }[];
    };
    topics?: {
      title?: string;
      items?: readonly Item[];
    };
    formats?: {
      title?: string;
      items?: readonly Item[];
    };
    speakerPerks?: {
      title?: string;
      items?: readonly string[];
    };
    guidelines?: {
      title?: string;
      items?: readonly string[];
    };
    cta?: string;
    ctaHref?: string;
    ctaDisabled?: boolean;
  };
  venue?: {
    title?: string;
    venueName?: string;
    description?: string;
    ctas?: readonly ActionItem[];
  };
  callToAction: {
    title?: string;
    subtitle?: string;
    actions: readonly ActionItem[];
  };
  countdownLabels?: {
    days: string;
    hours: string;
    minutes: string;
    seconds: string;
  };
}

const { hero, note, about, cfp, venue, callToAction, countdownLabels } = Astro.props;

const heroActionsWithPermalinks = hero.actions.map((action: ActionItem) => ({
  ...action,
  href: getPermalink(action.href),
}));

const callToActionActionsWithPermalinks = callToAction.actions.map((action: ActionItem) => ({
  ...action,
  href: getPermalink(action.href),
}));

const venueCtasWithPermalinks = (venue?.ctas ?? []).map((cta: ActionItem) => ({
  ...cta,
  href: cta.href?.startsWith('http') ? cta.href : getPermalink(cta.href),
}));

const cfpPhase: CfpAvailabilityPhase | undefined = cfp?.availability ? resolveCfpPhase(cfp.availability) : undefined;
const cfpStatus = cfp?.availability && cfpPhase ? cfp.availability.statuses[cfpPhase] : cfp?.status;
const cfpCtaDisabled = cfpPhase ? cfpPhase !== 'open' : (cfp?.ctaDisabled ?? false);
const cfpCtaTarget = cfp?.ctaHref?.startsWith('http') ? '_blank' : undefined;

const heroTitleHtml =
  typeof hero?.title === 'string'
    ? hero.title
    : [hero?.title?.main, hero?.title?.subtitle].filter(Boolean).join('<br class="block" />');

const heroBadge = hero?.badge;
const cfpImage = cfp?.image && typeof cfp.image !== 'string' ? (cfp.image as ImageType) : undefined;
---

<Hero actions={heroActionsWithPermalinks} image={hero.image} tagline={heroBadge}>
  <Fragment slot="title" set:html={heroTitleHtml} />
  <Fragment slot="subtitle" set:text={hero.subtitle} />
  {hero.eventDate && countdownLabels && <CountDown slot="title" eventDate={hero.eventDate} labels={countdownLabels} />}
</Hero>

<Note title={note.title} description={note.description} />

{about && (
    <>
      <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl" id={about.id}>
        <div class="mb-10 md:mx-auto text-center md:mb-12 max-w-3xl">
          {about.title && (
            <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
              {about.title}
            </h2>
          )}
        </div>
        {about.intro && (
          <div class="mb-6 text-xl text-muted dark:text-slate-300 max-w-3xl mx-auto">
            <p>{about.intro}</p>
          </div>
        )}
        {about.paragraph2 && (
          <div class="mb-10 text-xl text-muted dark:text-slate-300 max-w-3xl mx-auto">
            <p>{about.paragraph2}</p>
          </div>
        )}
        {about.stats && about.stats.length > 0 && <Stats stats={[...about.stats]} />}
        {about.whatToExpect && (
          <Features title={about.whatToExpect.title} items={[...(about.whatToExpect.items ?? [])]} columns={3} />
        )}
        {about.values && <Features title={about.values.title} items={[...(about.values.items ?? [])]} columns={3} />}
      </section>
    </>
  )}

{cfp && (
    <section
      class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl"
      id={cfp.id}
      data-cfp-root={cfp.availability ? 'true' : undefined}
      data-cfp-opens-at={cfp.availability?.opensAt}
      data-cfp-closes-at={cfp.availability?.closesAt ?? ''}
      data-cfp-status-upcoming={cfp.availability?.statuses.upcoming}
      data-cfp-status-open={cfp.availability?.statuses.open}
      data-cfp-status-closed={cfp.availability?.statuses.closed}
    >
      <div class="mb-10 md:mx-auto text-center md:mb-12 max-w-3xl">
        <p class="mb-3 text-sm font-semibold tracking-wider uppercase text-primary">CFP</p>
        {cfp.title && (
          <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">{cfp.title}</h2>
        )}
        {cfp.intro && <p class="text-xl text-muted dark:text-slate-300 leading-relaxed">{cfp.intro}</p>}
        {cfpStatus && (
          <div class="mt-6">
            <span
              data-cfp-status
              class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-4 py-2 text-sm font-semibold text-primary dark:border-primary/30 dark:bg-primary/20 dark:text-primary"
            >
              {cfpStatus}
            </span>
          </div>
        )}
        {cfp.cta && (
          <div class="mt-8 flex justify-center">
            <Button
              data-cfp-link
              href={cfp.ctaHref ?? '#'}
              target={cfpCtaTarget}
              text={cfp.cta}
              icon="tabler:external-link"
              variant="primary"
              aria-hidden={cfpCtaDisabled ? 'true' : 'false'}
              hidden={cfpCtaDisabled}
              class="w-full max-w-sm justify-center shadow-lg shadow-primary/20"
            />
          </div>
        )}
      </div>

      {cfp.image && (
        <div class="mb-10 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-slate-900">
          {typeof cfp.image === 'string' ? (
            <Fragment set:html={cfp.image} />
          ) : (
            cfpImage && (
              <Image
                class="w-full bg-gray-500"
                width={1200}
                height={675}
                widths={[768, 1200]}
                sizes="100vw"
                layout="responsive"
                {...cfpImage}
              />
            )
          )}
        </div>
      )}

      <div class="space-y-8">
        {(cfp.importantDates || cfp.topics) && (
          <div class="grid gap-6 lg:grid-cols-2">
            {cfp.importantDates && (
              <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-slate-900">
                <h3 class="mb-4 text-2xl font-bold">{cfp.importantDates.title}</h3>
                <ul class="space-y-3">
                  {cfp.importantDates.items?.map((item: { label: string; date: string }) => (
                    <li class="flex items-center justify-between gap-4 rounded-md border border-gray-200 px-4 py-3 dark:border-gray-700">
                      <span class="text-muted dark:text-slate-300">{item.label}</span>
                      <span class="font-semibold text-default dark:text-slate-100">{item.date}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {cfp.topics && (
              <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-slate-900">
                <h3 class="mb-4 text-2xl font-bold">{cfp.topics.title}</h3>
                <ul class="grid gap-3 sm:grid-cols-2">
                  {cfp.topics.items?.map((topic: Item) => (
                    <li class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-slate-800">
                      <p class="mb-1 font-semibold text-default dark:text-slate-100">{topic.title}</p>
                      <p class="text-sm text-muted dark:text-slate-300">{topic.description}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        {cfp.formats && (
          <div>
            <h3 class="mb-4 text-2xl font-bold">{cfp.formats.title}</h3>
            <ul class="grid gap-3 sm:grid-cols-2">
              {cfp.formats.items?.map((format: Item) => (
                <li class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-slate-900">
                  <p class="mb-1 font-semibold text-default dark:text-slate-100">{format.title}</p>
                  <p class="text-sm text-muted dark:text-slate-300">{format.description}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {(cfp.speakerPerks || cfp.guidelines) && (
          <div class="grid gap-4 sm:grid-cols-2">
            {cfp.speakerPerks && (
              <div class="rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-slate-900">
                <h3 class="mb-3 text-xl font-bold">{cfp.speakerPerks.title}</h3>
                <ul class="space-y-2 text-muted dark:text-slate-300">
                  {cfp.speakerPerks.items?.map((perk: string) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-2 h-2 w-2 rounded-full bg-primary" aria-hidden="true" />
                      <span>{perk}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {cfp.guidelines && (
              <div class="rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-slate-900">
                <h3 class="mb-3 text-xl font-bold">{cfp.guidelines.title}</h3>
                <ul class="space-y-2 text-muted dark:text-slate-300">
                  {cfp.guidelines.items?.map((guideline: string) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-2 h-2 w-2 rounded-full bg-primary" aria-hidden="true" />
                      <span>{guideline}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        {cfp.cta && (
          <div class="pt-2 text-center">
            <span
              data-cfp-disabled
              role="button"
              aria-disabled="true"
              aria-hidden={cfpCtaDisabled ? 'false' : 'true'}
              hidden={!cfpCtaDisabled}
              class="inline-flex cursor-not-allowed items-center justify-center rounded-md bg-gray-400 px-6 py-3 font-semibold text-white opacity-60 dark:bg-gray-600"
            >
              {cfp.cta}
            </span>
            <a
              data-cfp-link
              href={cfp.ctaHref ?? '#'}
              target={cfpCtaTarget}
              aria-hidden={cfpCtaDisabled ? 'true' : 'false'}
              hidden={cfpCtaDisabled}
              class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 font-semibold text-white transition hover:opacity-90"
              {...(cfp.ctaHref?.startsWith('http') ? { rel: 'noopener noreferrer' } : {})}
            >
              {cfp.cta}
            </a>
          </div>
        )}
      </div>
    </section>
  )}

<script>
import { type CfpAvailabilityPhase, resolveCfpPhase } from '~/domains/event/cfp/availability';

const syncCfpState = (root: HTMLElement) => {
  const opensAtValue = root.dataset.cfpOpensAt;

  if (!opensAtValue) {
    return;
  }

  let phase: CfpAvailabilityPhase;

  try {
    phase = resolveCfpPhase({
      opensAt: root.dataset.cfpOpensAt ?? '',
      closesAt: root.dataset.cfpClosesAt || undefined,
    });
  } catch {
    return;
  }

  const statusByPhase: Record<CfpAvailabilityPhase, string | undefined> = {
    upcoming: root.dataset.cfpStatusUpcoming,
    open: root.dataset.cfpStatusOpen,
    closed: root.dataset.cfpStatusClosed,
  };

  const statusElement = root.querySelector<HTMLElement>('[data-cfp-status]');
  const disabledElements = root.querySelectorAll<HTMLElement>('[data-cfp-disabled]');
  const linkElements = root.querySelectorAll<HTMLElement>('[data-cfp-link]');
  const isDisabled = phase !== 'open';

  if (statusElement && statusByPhase[phase]) {
    statusElement.textContent = statusByPhase[phase] ?? '';
  }

  disabledElements.forEach((disabledElement) => {
    disabledElement.hidden = !isDisabled;
    disabledElement.setAttribute('aria-hidden', String(!isDisabled));
  });

  linkElements.forEach((linkElement) => {
    linkElement.hidden = isDisabled;
    linkElement.setAttribute('aria-hidden', String(isDisabled));
  });
};

const syncAllCfpStates = () => {
  document.querySelectorAll<HTMLElement>('[data-cfp-root="true"]').forEach((root) => syncCfpState(root));
};

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', syncAllCfpStates, { once: true });
} else {
  syncAllCfpStates();
}

document.addEventListener('astro:page-load', syncAllCfpStates);
</script>

{venue && (
    <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl">
      <div class="mb-10 md:mx-auto text-center md:mb-12 max-w-3xl">
        {venue.title && (
          <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
            {venue.title}
          </h2>
        )}
        {venue.venueName && <p class="text-2xl font-semibold text-primary mb-6">{venue.venueName}</p>}
      </div>
      {venue.description && (
        <div class="mb-10 text-xl text-muted dark:text-slate-300 max-w-3xl mx-auto text-center">
          <p>{venue.description}</p>
        </div>
      )}
      {venueCtasWithPermalinks.length > 0 && (
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          {venueCtasWithPermalinks.map((cta) => (
            <Button
              {...cta}
              variant={cta.variant ?? 'primary'}
              class="px-6 py-3 text-sm font-semibold"
              target={cta.href?.startsWith('http') ? '_blank' : undefined}
              rel={cta.href?.startsWith('http') ? 'noreferrer' : undefined}
            />
          ))}
        </div>
      )}
    </section>
  )}

<CallToAction title={callToAction.title} subtitle={callToAction.subtitle} actions={callToActionActionsWithPermalinks} />
