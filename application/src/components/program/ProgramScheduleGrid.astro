---
import { groupProgramSessionsBySlot, type ProgramRoom, type ProgramSession, type ProgramTrack } from '~/utils/program';
import { ProgramSearchTextNormalizer } from '~/utils/program-search';
import ProgramSessionCard from './ProgramSessionCard.astro';

import type { ProgramScheduleLabels } from './program-schedule.types';

interface Props {
  labels: ProgramScheduleLabels;
  tracks: readonly ProgramTrack[];
  rooms: readonly ProgramRoom[];
  sessions: readonly ProgramSession[];
  timezone: string;
}

const { labels, tracks, rooms, sessions, timezone } = Astro.props;

const roomMap = new Map(rooms.map((room) => [room.id, room]));
const trackLabelMap = new Map(tracks.map((track) => [track.id, track.label]));
const roomLabelMap = new Map(rooms.map((room) => [room.id, room.label]));
const slots = groupProgramSessionsBySlot(sessions);
const allTrackIds = tracks.map((track) => track.id);

const formatTime = (value: string) =>
  new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: timezone,
  }).format(new Date(value));

const getSessionSearchText = (session: ProgramSession) =>
  ProgramSearchTextNormalizer.fromSession(session, trackLabelMap, roomLabelMap);
---

<section
  class="rounded-[2rem] border border-gray-200 bg-white p-3 shadow-lg shadow-slate-900/5 dark:border-slate-800 dark:bg-slate-900/90"
>
  <div class="space-y-3">
    <div class="hidden gap-3 lg:grid lg:grid-cols-[7.5rem_repeat(3,minmax(0,1fr))]">
      <div
        class="rounded-[1.5rem] border border-transparent px-4 py-3 text-xs font-semibold uppercase tracking-[0.18em] text-muted"
      >
        {labels.timeLabel}
      </div>
      {tracks.map((track) => (
          <div class="rounded-[1.5rem] border border-gray-200 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-950/60">
            <div class={`h-1.5 rounded-full bg-gradient-to-r ${track.accent}`} />
            <div class="mt-3 text-sm font-semibold text-gray-900 dark:text-white">{track.label}</div>
          </div>
        ))}
    </div>

    {slots.map((slot) => {
        const globalSessions = slot.sessions.filter(
          (session) => session.isGlobal || session.trackIds.length === allTrackIds.length
        );
        const trackSessions = slot.sessions.filter((session) => !globalSessions.includes(session));

        return (
          <section
            class="grid items-start gap-3 rounded-[1.75rem] border border-gray-200/80 bg-slate-50/70 p-3 lg:grid-cols-[7.5rem_repeat(3,minmax(0,1fr))] dark:border-slate-800 dark:bg-slate-950/40"
            data-program-slot
          >
            <div class="rounded-[1.35rem] border border-gray-200 bg-white px-4 py-4 text-sm shadow-sm lg:sticky lg:left-0 lg:top-0 lg:self-stretch dark:border-slate-800 dark:bg-slate-900">
              <p class="font-semibold text-gray-900 dark:text-white">{formatTime(slot.startsAt)}</p>
              <p class="mt-1 text-xs text-muted">{formatTime(slot.endsAt)}</p>
            </div>

            <div class="space-y-3 lg:col-span-3">
              {globalSessions.map((session) => (
                <ProgramSessionCard
                  session={session}
                  isGlobal={true}
                  trackLabel={labels.globalLabel}
                  tone="from-sky-500 to-cyan-400"
                  roomLabel={session.roomIds.map((roomId) => roomMap.get(roomId)?.label ?? roomId).join(' · ')}
                  labels={labels}
                  searchText={getSessionSearchText(session)}
                />
              ))}

              {trackSessions.length > 0 && (
                <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
                  {tracks.map((track) => {
                    const session = trackSessions.find((entry) => entry.trackIds.includes(track.id));
                    return session ? (
                      <ProgramSessionCard
                        session={session}
                        isGlobal={false}
                        trackLabel={track.label}
                        tone={track.accent}
                        roomLabel={session.roomIds.map((roomId) => roomMap.get(roomId)?.label ?? roomId).join(' · ')}
                        labels={labels}
                        searchText={getSessionSearchText(session)}
                      />
                    ) : (
                      <div class="hidden min-h-[12rem] items-center justify-center rounded-[1.5rem] border border-dashed border-gray-200 bg-white/70 px-4 py-5 text-center text-xs text-muted lg:flex dark:border-slate-700 dark:bg-slate-950/30">
                        {labels.emptyTrackSlotLabel}
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          </section>
        );
      })}
  </div>
</section>
