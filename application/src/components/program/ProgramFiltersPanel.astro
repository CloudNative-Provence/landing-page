---
import type { ProgramRoom, ProgramTrack } from '~/utils/program';

import type { ProgramScheduleFilters } from './program-schedule.types';

interface Props {
  filters: ProgramScheduleFilters;
  tracks: readonly ProgramTrack[];
  rooms: readonly ProgramRoom[];
}

const { filters, tracks, rooms } = Astro.props;
---

<section
  class="sticky top-20 z-20 rounded-[1.75rem] border border-gray-200/80 bg-white/90 p-4 shadow-lg shadow-slate-900/5 backdrop-blur md:top-24 dark:border-slate-800 dark:bg-slate-900/90"
>
  <div class="grid gap-3 xl:grid-cols-[minmax(0,2fr)_repeat(3,minmax(0,1fr))_auto] xl:items-end">
    <label class="block">
      <span class="mb-2 block text-sm font-medium text-gray-700 dark:text-slate-200">{filters.searchLabel}</span>
      <input
        data-filter-search
        type="search"
        placeholder={filters.searchPlaceholder}
        class="w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:ring-sky-900/30"
      >
    </label>

    <label class="block">
      <span class="mb-2 block text-sm font-medium text-gray-700 dark:text-slate-200">{filters.trackLabel}</span>
      <select
        data-filter-track
        class="w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:ring-sky-900/30"
      >
        <option value="">{filters.allTracksLabel}</option>
        {tracks.map((track) => <option value={track.id}>{track.label}</option>)}
      </select>
    </label>

    <label class="block">
      <span class="mb-2 block text-sm font-medium text-gray-700 dark:text-slate-200">{filters.roomLabel}</span>
      <select
        data-filter-room
        class="w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:ring-sky-900/30"
      >
        <option value="">{filters.allRoomsLabel}</option>
        {rooms.map((room) => <option value={room.id}>{room.label}</option>)}
      </select>
    </label>

    <label class="flex h-full items-center gap-3 rounded-2xl border border-gray-200 px-4 py-3 dark:border-slate-700">
      <input data-filter-selected type="checkbox" class="h-4 w-4 rounded border-gray-300 text-sky-500">
      <span class="text-sm text-gray-700 dark:text-slate-200">{filters.selectedOnlyLabel}</span>
    </label>

    <button
      type="button"
      data-filter-reset
      class="inline-flex h-fit items-center justify-center rounded-2xl border border-gray-200 px-4 py-3 text-sm font-medium text-gray-700 transition hover:border-sky-300 hover:text-sky-600 dark:border-slate-700 dark:text-slate-200"
    >
      {filters.resetLabel}
    </button>
  </div>
</section>
