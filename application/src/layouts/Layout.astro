---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';
// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';
import { I18N } from 'astrowind:config';
import { getLangFromUrl } from '~/i18n/utils';
import CustomStyles from '~/shared/components/CustomStyles.astro';
import Analytics from '~/shared/components/common/Analytics.astro';
import ApplyColorMode from '~/shared/components/common/ApplyColorMode.astro';
import BasicScripts from '~/shared/components/common/BasicScripts.astro';
import CommonMeta from '~/shared/components/common/CommonMeta.astro';
import LanguageAlternates from '~/shared/components/common/LanguageAlternates.astro';
import Metadata from '~/shared/components/common/Metadata.astro';
import SiteVerification from '~/shared/components/common/SiteVerification.astro';
import Favicons from '~/shared/components/Favicons.astro';
import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const textDirection = I18N?.textDirection || 'ltr';
---

<!doctype html>
<html lang={currentLang} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <Font cssVariable="--font-montserrat" preload />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <LanguageAlternates />
    <SiteVerification />
    <Analytics />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />
  </body>
</html>
