---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import LanguageSwitcher from '~/shared/components/common/LanguageSwitcher.astro';
import ToggleMenu from '~/shared/components/common/ToggleMenu.astro';
import ToggleTheme from '~/shared/components/common/ToggleTheme.astro';
import Logo from '~/shared/components/Logo.astro';
import Button from '~/shared/components/ui/Button.astro';
import type { NavigationLink } from '~/shared/navigation/types';
import { getAsset, getHomePermalink, trimSlash } from '~/shared/url/permalinks';
import type { CallToAction } from '~/types';
import './header.css';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  id?: string;
  promotion?: NavigationLink['promotion'];
  sectionOrder?: number;
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  eventNavigation?: { startsAt: string; timeZone: string; eventDay: boolean };
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  eventNavigation,
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const t = useTranslations(getLangFromUrl(Astro.url)).header;
const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const panelId = `${id || 'site-header'}-navigation`;
---

<header
  class:list={['site-header top-0 z-40 mx-auto w-full', { sticky: isSticky, relative: !isSticky, dark: isDark }]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="header-backdrop absolute inset-0"></div>
  <header-navigation
    class:list={['header-inner', { 'header-full-width': isFullWidth }]}
    data-position={position}
    data-event-starts-at={eventNavigation?.startsAt}
    data-event-time-zone={eventNavigation?.timeZone}
    data-event-day={eventNavigation ? String(eventNavigation.eventDay) : undefined}
  >
    <a class="header-brand" href={getHomePermalink()}><Logo /></a>
    <div class="header-menu-toggle"><ToggleMenu label={t.menuToggleLabel} controls={panelId} /></div>
    <div class="header-panel" id={panelId} data-header-panel>
      <nav class="header-nav" aria-label={t.navigationLabel}>
        <ul class="header-links">
          {links.map(({ id: sectionId, text, href, icon, promotion, sectionOrder, links: children }) => (
            <li data-nav-section={sectionId} data-nav-promotion={promotion} data-nav-order={sectionOrder}>
              {children?.length ? (
                <details class="header-group" name={`${panelId}-groups`} data-nav-group>
                  <summary
                    class:list={['header-link', { 'is-active': children.some((child) => child.href === currentPath) }]}
                  >
                    {text}
                    <Icon name="tabler:chevron-down" class="header-chevron" />
                  </summary>
                  <ul class="header-submenu">
                    {children.map((child) => (
                      <li data-nav-promotion={child.promotion} data-nav-order={child.sectionOrder}>
                        <a
                          href={child.href}
                          class:list={['header-sublink', { 'is-active': child.href === currentPath }]}
                          aria-current={child.href === currentPath ? 'page' : undefined}
                        >
                          {child.icon && <Icon name={child.icon} class="header-link-icon" />}
                          {child.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  class:list={['header-link', { 'is-active': href === currentPath }]}
                  href={href}
                  aria-current={href === currentPath ? 'page' : undefined}
                >
                  {icon && <Icon name={icon} class="header-link-icon" />}
                  {text}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class="header-tools">
        <LanguageSwitcher />
        {showToggleTheme && <ToggleTheme label={t.themeToggleLabel} iconClass="w-5 h-5" />}
        {showRssFeed && (
          <a class="header-rss" aria-label={t.rssFeedLabel} href={getAsset('/rss.xml')}>
            <Icon name="tabler:rss" class="w-5 h-5" />
          </a>
        )}
        {actions?.length ? (
          <div class="header-actions">
            {actions.map((btnProps) => (
              <Button {...btnProps} class="py-2.5 px-5 font-semibold shadow-none text-sm" />
            ))}
          </div>
        ) : null}
      </div>
    </div>
  </header-navigation>
</header>

<script>
import './header-navigation';
</script>
