{
  "name": "application",
  "version": "0.0.0",
  "description": "Landing page for the Cloud Native Province conference",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run test -- --reporter=default --reporter=junit --outputFile=junit.xml --coverage.enabled --coverage.reporter=lcov --coverage.reporter=text",
    "lint": "npm run lint:astro && npm run lint:biome",
    "lint:astro": "astro check",
    "lint:biome": "biome check --assist-enabled=false .",
    "lint:fix": "npm run lint:fix:biome && npm run lint:astro",
    "lint:fix:biome": "biome check --assist-enabled=false --write .",
    "lint:ci:astro": "astro check | tee astro-report.txt",
    "lint:ci:biome": "biome check --assist-enabled=false . --reporter=sarif | tee biome-report.sarif",
    "lint:ci": "npm run lint:ci:astro && npm run lint:ci:biome"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^7.2.8",
    "astro-icon": "^1.2.0",
    "fflate": "^0.8.3",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/partytown": "^2.1.7",
    "@biomejs/biome": "^2.5.10",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/tabler": "^1.2.38",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.14",
    "@vitest/coverage-v8": "^4.1.11",
    "astro-compress": "2.4.3",
    "js-yaml": "^5.4.1",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true
  }
}
