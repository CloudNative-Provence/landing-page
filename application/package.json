{
  "name": "application",
  "version": "0.0.0",
  "description": "Landing page for the Cloud Native Provence conference",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run test -- --reporter=default --reporter=junit --outputFile=junit.xml --coverage.enabled --coverage.reporter=lcov --coverage.reporter=text",
    "lint": "npm run lint:astro && npm run lint:eslint && npm run lint:prettier",
    "lint:astro": "astro check",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:fix": "npm run lint:fix:astro && npm run lint:fix:eslint && npm run lint:fix:prettier",
    "lint:fix:astro": "npm run lint:astro -- --fix",
    "lint:fix:eslint": "npm run lint:eslint -- --fix .",
    "lint:fix:prettier": "npm run lint:prettier -- -w",
    "lint:ci:astro": "npm run lint:astro | tee astro-report.txt",
    "lint:ci:eslint": "npm run lint:eslint -- --format json -o eslint-report.json",
    "lint:ci:prettier": "npm run lint:prettier | tee prettier-report.txt",
    "lint:ci": "npm run lint:ci:astro && npm run lint:ci:eslint && npm run lint:ci:prettier"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^7.2.0",
    "astro-icon": "^1.1.5",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/partytown": "^2.1.7",
    "@eslint/js": "^10.0.1",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/tabler": "^1.2.38",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.14",
    "@vitest/coverage-v8": "^4.1.10",
    "astro-compress": "2.4.2",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.9.0",
    "js-yaml": "^5.2.3",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.27.7": true
  }
}
