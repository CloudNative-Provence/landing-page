[codespell]
# Skip third-party/generated paths and French-locale content files.
ignore-words-list = afterAll,provence
skip = .git,.tmp-super-linter/**,super-linter-output/**,*.svg,**/package-lock.json,**/application/*/dist/**,**/application/*/node_modules/**,**/application/*/coverage/**,**/application/*/.astro/**,**/application/src/domains/**/*.fr.ts,**/application/src/domains/**/*.fr.md,**/application/src/domains/**/fr.ts,**/application/src/domains/**/fr.md,**/application/src/domains/event/sponsors/sponsors.ts
