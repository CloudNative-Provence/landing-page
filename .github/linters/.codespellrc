[codespell]
# Skip third-party/generated paths and French-locale content files.
ignore-words-list = afterAll,provence
skip = .git,*.svg,**/package-lock.json,**/application/*/dist/**,**/application/*/node_modules/**,**/application/*/coverage/**,**/application/*/.astro/**,**/application/src/data/**/fr.ts,**/application/src/data/**/fr.md
